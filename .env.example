# ==============================================================================
# AICTE Security Deposit / FDR Portal — Environment Configuration Example
# ==============================================================================

# Application Security
SECRET_KEY=replace_with_a_secure_jwt_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default zero-setup local SQLite fallback:
DATABASE_URL=sqlite:///./aicte_fdr.db
# Or PostgreSQL / RDS instance:
# DATABASE_URL=postgresql://aicte_user:aicte_password@localhost:5432/aicte_fdr

# AWS Cloud Configuration (Selected Region: ap-southeast-2)
AWS_REGION=ap-southeast-2

# S3 Document Storage (Set to true when configured)
USE_AWS_S3=false
S3_BUCKET_NAME=aicte-fdr-documents-ap-southeast-2

# Amazon Cognito Authentication (Set to true when configured)
USE_AWS_COGNITO=false
COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon SNS Notifications (Set to true when configured)
USE_AWS_SNS=false
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:aicte-fdr-portal-alerts

# Local Development & Hackathon Demo Mode
DEMO_MODE=true
